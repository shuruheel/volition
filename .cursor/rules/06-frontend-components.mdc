## Phone Call Activity Card

Special handling for phone calls with summaries:

```typescript
// components/phone-activity-card.tsx
import { Card } from '@/components/ui/card';
import { Button } from '@/components/ui/button';
import { Phone } from 'lucide-react';

interface PhoneActivityCardProps {
  activity: {
    id: string;
    status: 'pending' | 'completed';
    payload: {
      toNumber?: string;
      summary?: string;
      duration?: number;
    };
    created_at: string;
  };
  onApprove?: (id: string) => void;
}

export function PhoneActivityCard({ activity, onApprove }: PhoneActivityCardProps) {
  const isPending = activity.status === 'pending';
  
  return (
    <Card className="p-4">
      <div className="flex items-start gap-4">
        <div className="p-3 bg-blue-100 rounded-lg">
          <Phone className="w-6 h-6 text-blue-600" />
        </div>
        
        <div className="flex-1">
          <h4 className="font-semibold">Phone Call</h4>
          {isPending ? (
            <p className="text-sm text-muted-foreground mt-1">
              Requesting to call {activity.payload.toNumber}
            </p>
          ) : (
            <>
              <p className="text-sm text-muted-foreground mt-1">
                Call completed ({activity.payload.duration}s)
              </p>
              {activity.payload.summary && (
                <p className="text-sm mt-2 p-3 bg-muted rounded-lg">
                  {activity.payload.summary}
                </p>
              )}
            </>
          )}
          
          {isPending && onApprove && (
            <div className="flex gap-2 mt-3">
              <Button size="sm" onClick={() => onApprove(activity.id)}>
                Approve Call
              </Button>
              <Button size="sm" variant="outline">
                Reject
              </Button>
            </div>
          )}
        </div>
      </div>
    </Card>
  );
}
```

