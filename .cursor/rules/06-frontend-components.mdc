# Frontend Components & UI Patterns

## Component Architecture

This project uses:
- **React 18+** with Next.js 16 App Router
- **shadcn/ui** for UI components
- **Tailwind CSS** for styling
- **TypeScript** for type safety

## Component Structure

```
components/
├── ui/                          # shadcn/ui primitives
│   ├── button.tsx
│   ├── card.tsx
│   ├── dialog.tsx
│   └── ...
├── unified-activity-card.tsx    # Main activity display
├── activity-card.tsx            # Base activity card
├── *-activity-card.tsx          # Specific activity variants
├── metric-card.tsx              # Dashboard metrics
├── agent-card.tsx               # Agent display
├── tool-permissions-selector.tsx # Tool selection UI
├── chat-drawer.tsx              # Chat interface
└── knowledge-graph.tsx          # Graph visualization
```

## Activity Feed System

### Activity Types (Filtered)

**Include in feed:**
- `research` - Research tasks
- `email_sent` - Emails sent (future Composio)
- `phone_call` - Phone calls via Twilio
- `calendar_event_created` - Calendar events created
- `calendar_event_updated` - Calendar events updated
- `webpage_viewed` - Webpages visited
- `journal_read` - Journal entries

**Exclude from feed:**
- `video_watched` - Too high frequency
- `financial` - Deferred to v2
- `image_seen` - Too high frequency
- `email_read` - Noise (only show sent)

### Unified Activity Card

```typescript
// components/unified-activity-card.tsx
import { Card } from '@/components/ui/card';

interface ActivityCardProps {
  activity: {
    id: string;
    type: 'research' | 'email_sent' | 'phone_call' | 'calendar_event_created' | 'webpage_viewed' | 'journal_read';
    status: 'pending' | 'approved' | 'completed' | 'rejected';
    priority: number;
    created_at: string;
    payload: Record<string, any>;
  };
  onApprove?: (id: string) => void;
  onReject?: (id: string) => void;
}

export function UnifiedActivityCard({ activity, onApprove, onReject }: ActivityCardProps) {
  // Render different UI based on activity.type
  switch (activity.type) {
    case 'research':
      return <ResearchActivityCard activity={activity} />;
    
    case 'phone_call':
      return <PhoneActivityCard activity={activity} onApprove={onApprove} />;
    
    case 'email_sent':
      return <EmailActivityCard activity={activity} />;
    
    // ... other types
    
    default:
      return <ActivityCard activity={activity} />;
  }
}
```

### Activity List with Filtering

```typescript
// app/dashboard/page.tsx or app/dashboard/[agentId]/page.tsx
import { UnifiedActivityCard } from '@/components/unified-activity-card';

export default async function DashboardPage() {
  // Fetch activities with type filtering
  const response = await fetch('/api/activities?types=research,email_sent,phone_call,calendar_event_created,webpage_viewed,journal_read');
  const { activities } = await response.json();
  
  return (
    <div className="space-y-4">
      <h2 className="text-2xl font-bold">Activity Feed</h2>
      
      {activities.length === 0 ? (
        <p className="text-muted-foreground">No activities yet</p>
      ) : (
        <div className="space-y-3">
          {activities.map((activity) => (
            <UnifiedActivityCard
              key={activity.id}
              activity={activity}
              onApprove={handleApprove}
              onReject={handleReject}
            />
          ))}
        </div>
      )}
    </div>
  );
}
```

## Metric Cards

### Key Metrics (7 total)

```typescript
// components/metric-card.tsx
interface MetricCardProps {
  title: string;
  value: string | number;
  icon: React.ReactNode;
  trend?: {
    value: number;
    isPositive: boolean;
  };
  onClick?: () => void;
}

export function MetricCard({ title, value, icon, trend, onClick }: MetricCardProps) {
  return (
    <Card className="p-6 cursor-pointer hover:shadow-md transition-shadow" onClick={onClick}>
      <div className="flex items-center justify-between">
        <div>
          <p className="text-sm text-muted-foreground">{title}</p>
          <h3 className="text-3xl font-bold mt-2">{value}</h3>
          {trend && (
            <p className={`text-sm mt-1 ${trend.isPositive ? 'text-green-600' : 'text-red-600'}`}>
              {trend.isPositive ? '↑' : '↓'} {Math.abs(trend.value)}% from yesterday
            </p>
          )}
        </div>
        <div className="text-4xl opacity-20">{icon}</div>
      </div>
    </Card>
  );
}
```

