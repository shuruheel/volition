  onClick?: (id: string) => void;
}

export function AgentCard({ agent, onClick }: AgentCardProps) {
  // ...
}
```

### 4. Accessibility

- Use semantic HTML
- Add aria labels
- Support keyboard navigation
- Use proper heading hierarchy

### 5. Loading States

```typescript
