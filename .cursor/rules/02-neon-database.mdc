# Neon Database Integration

## Overview

This project uses **Neon Postgres** - a serverless Postgres platform with autoscaling, branching, and scale-to-zero capabilities.

Documentation: [docs/neon/README.md](mdc:docs/neon/README.md)

## Driver Setup

Use `@neondatabase/serverless` for low-latency HTTP/WebSocket access:

```typescript
// lib/db.ts
import { neon } from '@neondatabase/serverless';

// For simple queries (HTTP)
export const sql = neon(process.env.DATABASE_URL!);

// For connection pooling (recommended for route handlers)
import { Pool } from '@neondatabase/serverless';
export const pool = new Pool({ 
  connectionString: process.env.DATABASE_URL_POOLED 
});
```

Reference: [docs/neon/serverless-driver.md](mdc:docs/neon/serverless-driver.md)

## Connection Strings

Use two connection strings:

1. **DATABASE_URL** - Direct connection for migrations and admin tasks
2. **DATABASE_URL_POOLED** - Pooled connection with `?pgbouncer=true` for route handlers

```bash
# .env.local
DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL_POOLED=postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require&pgbouncer=true
```

## Query Patterns

### Simple Queries (HTTP)

Use for read-only operations and simple inserts:

```typescript
import { sql } from '@/lib/db';

// SELECT
const agents = await sql`SELECT * FROM agents WHERE status = 'active'`;

// INSERT with RETURNING
const [agent] = await sql`
  INSERT INTO agents (name, prompt, tools)
  VALUES (${name}, ${prompt}, ${tools})
  RETURNING *
`;

// UPDATE
await sql`
  UPDATE agents 
  SET status = ${status}, updated_at = NOW()
  WHERE id = ${id}
`;
```

### Transactional Queries

Use `Pool` for transactions:

```typescript
import { pool } from '@/lib/db';

export async function createAgentWithMemory(data) {
  const client = await pool.connect();
  
  try {
    await client.query('BEGIN');
    
    const agentResult = await client.query(
      'INSERT INTO agents (name, prompt) VALUES ($1, $2) RETURNING id',
      [data.name, data.prompt]
    );
    
    await client.query(
      'INSERT INTO memories (agent_id, provider_id) VALUES ($1, $2)',
      [agentResult.rows[0].id, data.memoryId]
    );
    
    await client.query('COMMIT');
    return agentResult.rows[0];
  } catch (err) {
    await client.query('ROLLBACK');
    throw err;
  } finally {
    client.release();
  }
}
```

## Schema Design

### Use JSONB for Flexible Data

```sql
-- activities table with JSONB payload
CREATE TABLE activities (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  agent_id UUID REFERENCES agents(id),
  type VARCHAR(50) NOT NULL,
  status VARCHAR(20) DEFAULT 'pending',
  priority INTEGER DEFAULT 0,
  created_at TIMESTAMPTZ DEFAULT NOW(),
  payload JSONB -- Flexible structure per activity type
);

-- Index JSONB fields for queries
CREATE INDEX idx_activities_payload_gin ON activities USING GIN (payload);
CREATE INDEX idx_activities_type ON activities(type);
```

### Use Arrays for Lists

```sql
-- agents table with tools array
CREATE TABLE agents (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  name VARCHAR(255) NOT NULL,
  prompt TEXT,
  status VARCHAR(20) DEFAULT 'idle',
  tools TEXT[] DEFAULT '{}', -- Array of tool names
  created_at TIMESTAMPTZ DEFAULT NOW(),
  updated_at TIMESTAMPTZ DEFAULT NOW()
);

-- Query array fields
SELECT * FROM agents WHERE 'supermemory' = ANY(tools);
```

## Migrations

Use SQL files in `db/migrations/` with sequential numbering:

```sql
-- db/migrations/001_init.sql
CREATE TABLE IF NOT EXISTS users (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  email VARCHAR(255) UNIQUE NOT NULL,
  name VARCHAR(255),
  created_at TIMESTAMPTZ DEFAULT NOW()
);

-- Add indexes
CREATE INDEX idx_users_email ON users(email);

-- Add comments for documentation
COMMENT ON TABLE users IS 'User accounts (minimal for v1, expanded in v2)';
```

Run migrations:
```bash
psql $DATABASE_URL -f db/migrations/001_init.sql
```

## Best Practices

### 1. Always Use Parameterized Queries

✅ **Good:**
```typescript
await sql`SELECT * FROM agents WHERE id = ${agentId}`;
```

❌ **Bad:**
```typescript
await sql`SELECT * FROM agents WHERE id = '${agentId}'`; // SQL injection risk
```

### 2. Handle Errors Gracefully

```typescript
export async function getAgent(id: string) {
  try {
    const [agent] = await sql`SELECT * FROM agents WHERE id = ${id}`;
    return agent || null;
  } catch (error) {
    console.error('Database error:', error);
    throw new Error('Failed to fetch agent');
  }
}
```

### 3. Use Timestamps Consistently

- Use `TIMESTAMPTZ` for all timestamps
- Default to `NOW()` for creation timestamps
- Update `updated_at` via triggers or explicit UPDATE

```sql
CREATE TABLE agents (
  -- ...
  created_at TIMESTAMPTZ DEFAULT NOW(),
  updated_at TIMESTAMPTZ DEFAULT NOW()
);

-- Auto-update trigger
CREATE OR REPLACE FUNCTION update_updated_at_column()
RETURNS TRIGGER AS $$
BEGIN
  NEW.updated_at = NOW();
  RETURN NEW;
END;
$$ language 'plpgsql';

CREATE TRIGGER update_agents_updated_at BEFORE UPDATE ON agents
FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();
```

### 4. Index for Performance

Common indexes:
```sql
-- Foreign keys
CREATE INDEX idx_activities_agent_id ON activities(agent_id);
CREATE INDEX idx_memories_agent_id ON memories(agent_id);

-- Queries by status/type
CREATE INDEX idx_agents_status ON agents(status);
CREATE INDEX idx_activities_type_status ON activities(type, status);

-- Time-based queries
CREATE INDEX idx_activities_created_at ON activities(created_at DESC);
CREATE INDEX idx_calls_started_at ON calls(started_at DESC);

-- JSONB queries
CREATE INDEX idx_activities_payload_gin ON activities USING GIN (payload);
```

### 5. Connection Management

For Route Handlers:
```typescript
// app/api/agents/route.ts
import { sql } from '@/lib/db';

export async function GET() {
  try {
    const agents = await sql`SELECT * FROM agents`;
    return Response.json({ agents });
  } catch (error) {
    return Response.json({ error: 'Database error' }, { status: 500 });
  }
}
```

For WebSocket handlers or long-running connections:
```typescript
import { pool } from '@/lib/db';

const client = await pool.connect();
try {
  // Use client for multiple queries
} finally {
  client.release(); // Always release
}
```

## Database Branching

Neon supports Git-like branching for databases:

```bash
# Create a branch for testing
neonctl branches create --name test-feature --parent main

# Get connection string for branch
neonctl connection-string test-feature
```

Use cases:
- **Development**: Isolated development environments
- **Testing**: Run tests without affecting production
- **Preview deployments**: Branch per PR with Vercel integration

Reference: [docs/neon/branching.md](mdc:docs/neon/branching.md)

## AI Integration Patterns

### Store Embeddings (pgvector)

```sql
-- Enable pgvector
CREATE EXTENSION IF NOT EXISTS vector;

-- Add vector column
ALTER TABLE memories ADD COLUMN embedding vector(1536);

-- Vector similarity search
SELECT * FROM memories
WHERE agent_id = $1
ORDER BY embedding <-> $2
LIMIT 10;
```

Reference: [docs/neon/pgvector.md](mdc:docs/neon/pgvector.md)

### Store Tool Configurations

```typescript
import { encrypt, decrypt } from '@/lib/crypto';
import { sql } from '@/lib/db';

// Save encrypted credentials
export async function saveToolConfig(userId: string, tool: string, credentials: object) {
  const encrypted = await encrypt(JSON.stringify(credentials));
  
  await sql`
    INSERT INTO tool_configs (user_id, tool, data_encrypted)
    VALUES (${userId}, ${tool}, ${encrypted})
    ON CONFLICT (user_id, tool) 
    DO UPDATE SET data_encrypted = ${encrypted}, updated_at = NOW()
  `;
}

// Retrieve and decrypt
export async function getToolConfig(userId: string, tool: string) {
  const [config] = await sql`
    SELECT data_encrypted FROM tool_configs
    WHERE user_id = ${userId} AND tool = ${tool}
  `;
  
  if (!config) return null;
  
  const decrypted = await decrypt(config.data_encrypted);
  return JSON.parse(decrypted);
}
```

Reference: [lib/crypto.ts](mdc:lib/crypto.ts)

