## Context Management

### Provide Context to Tools

```typescript
const result = await agent.generate({
  prompt: userInput,
  
  // Pass context to all tool executions
  experimental_context: {
    agentId: agent.id,
    userId: currentUser.id,
    sessionId: sessionId,
  },
});

// Access in tool execute function
export const myTool = tool({
  // ...
  execute: async (input, { experimental_context }) => {
    const ctx = experimental_context as { agentId: string; userId: string };
    // Use ctx.agentId, ctx.userId
  },
});
```

### Message History Management

For longer conversations, compress messages:

```typescript
const result = await generateText({
  model: openai('gpt-4o'),
  messages: conversationHistory,
  tools: { /* ... */ },
  
  prepareStep: async ({ stepNumber, messages }) => {
    // Keep only recent messages for long conversations
    if (messages.length > 20) {
      return {
        messages: [
          messages[0], // Keep system message
          ...messages.slice(-10), // Keep last 10 messages
        ],
      };
    }
    return {};
  },
});
```

## Observability

### Step Logging

```typescript
const result = await agent.generate({
  prompt,
  
  onStepFinish: async ({ text, toolCalls, toolResults, usage, finishReason, stepNumber }) => {
    // Log to database
    await sql`
      INSERT INTO agent_steps (
        agent_id, step_number, text, tool_calls, 
        tool_results, usage, finish_reason
      ) VALUES (
        ${agentId}, ${stepNumber}, ${text}, 
        ${JSON.stringify(toolCalls)}, ${JSON.stringify(toolResults)},
        ${JSON.stringify(usage)}, ${finishReason}
      )
    `;
    
    // Log to console in development
    if (process.env.NODE_ENV === 'development') {
      console.log(`[Step ${stepNumber}] ${finishReason}`);
      console.log('Tools called:', toolCalls.map(tc => tc.toolName));
      console.log('Tokens:', usage.totalTokens);
    }
  },
});
```

### Usage Tracking

```typescript
const result = await agent.generate({ prompt });

// Track costs
const cost = calculateCost(result.usage);
await sql`
  UPDATE agents 
  SET total_spend = total_spend + ${cost}
  WHERE id = ${agentId}
`;

console.log('Usage:', {
  promptTokens: result.usage.promptTokens,
  completionTokens: result.usage.completionTokens,
  totalTokens: result.usage.totalTokens,
  cost,
});
```

## Error Handling

### Tool Execution Errors

```typescript
import { NoSuchToolError, InvalidToolInputError } from 'ai';

try {
  const result = await agent.generate({ prompt });
} catch (error) {
  if (NoSuchToolError.isInstance(error)) {
    console.error('Model tried to call unknown tool:', error.toolName);
  } else if (InvalidToolInputError.isInstance(error)) {
    console.error('Invalid tool input:', error.toolName, error.input);
  } else {
    console.error('Agent error:', error);
  }
}

// Check tool errors in steps
const toolErrors = result.steps.flatMap(step =>
  step.content.filter(part => part.type === 'tool-error')
);

for (const toolError of toolErrors) {
  console.error('Tool error:', toolError.toolName, toolError.error);
}
```

