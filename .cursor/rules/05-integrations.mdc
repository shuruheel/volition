### Status Callbacks

```typescript
// app/api/twilio/status/route.ts
export async function POST(request: Request) {
  const formData = await request.formData();
  
  const callSid = formData.get('CallSid');
  const callStatus = formData.get('CallStatus');
  const duration = formData.get('CallDuration');
  
  await sql`
    UPDATE calls
    SET status = ${callStatus}, ended_at = NOW()
    WHERE twilio_sid = ${callSid}
  `;
  
  // If call completed, trigger summary generation
  if (callStatus === 'completed') {
    await generateCallSummary(callSid);
  }
  
  return new Response('OK', { status: 200 });
}
```

### Call Summary Generation

```typescript
// app/api/calls/[id]/summary/route.ts
import { generateText } from 'ai';
import { openai } from '@ai-sdk/openai';

export async function POST(
  request: Request,
  context: RouteContext<'/api/calls/[id]/summary'>
) {
  const { id } = await context.params;
  
  // Get call transcript (from buffered Realtime events)
  const transcript = await getCallTranscript(id);
  
  // Generate summary with AI
  const { text } = await generateText({
    model: openai('gpt-4o'),
    prompt: `Summarize this phone call transcript:\n\n${transcript}`,
  });
  
  // Save summary
  await sql`
    UPDATE calls
    SET summary = ${text}
    WHERE id = ${id}
  `;
  
  // Create activity for feed
  await sql`
    INSERT INTO activities (agent_id, type, status, payload)
    SELECT agent_id, 'phone_call', 'completed', ${JSON.stringify({
      callId: id,
      summary: text,
    })}
    FROM calls WHERE id = ${id}
  `;
  
  return Response.json({ summary: text });
}
```

Reference: [docs/twilio/twilio-code-walkthrough.md](mdc:docs/twilio/twilio-code-walkthrough.md)

## Tool Configuration Management

### Store Encrypted Credentials

```typescript
// app/api/settings/tools/route.ts
import { encrypt, decrypt } from '@/lib/crypto';

export async function POST(request: Request) {
  const { tool, credentials } = await request.json();
  
  // Encrypt credentials
  const encrypted = await encrypt(JSON.stringify(credentials));
  
  await sql`
    INSERT INTO tool_configs (user_id, tool, data_encrypted)
    VALUES ('mock-user-id', ${tool}, ${encrypted})
    ON CONFLICT (user_id, tool)
    DO UPDATE SET data_encrypted = ${encrypted}, updated_at = NOW()
  `;
  
  return Response.json({ success: true });
}

export async function GET(request: Request) {
  const { searchParams } = new URL(request.url);
  const tool = searchParams.get('tool');
  
  const [config] = await sql`
    SELECT data_encrypted FROM tool_configs
    WHERE user_id = 'mock-user-id' AND tool = ${tool}
  `;
  
  if (!config) {
    return Response.json({ configured: false });
  }
  
  // Return masked version
  return Response.json({
    configured: true,
    masked: '••••••••',
  });
}
```

Reference: [lib/crypto.ts](mdc:lib/crypto.ts)

### Test Tool Connectivity

```typescript
// app/api/settings/test/route.ts
export async function POST(request: Request) {
  const { tool } = await request.json();
  
  try {
    switch (tool) {
      case 'openai':
        await fetch('https://api.openai.com/v1/models', {
          headers: { 'Authorization': `Bearer ${process.env.OPENAI_API_KEY}` },
        });
        break;
      
      case 'supermemory':
        const sm = new Supermemory({ apiKey: process.env.SUPERMEMORY_API_KEY! });
        await sm.documents.list({ limit: 1 });
        break;
      
      case 'browser_use':
        const bu = new BrowserUseClient({ apiKey: process.env.BROWSER_USE_API_KEY! });
        // Test API key validity
        break;
      
      case 'twilio':
        const tw = twilio(process.env.TWILIO_ACCOUNT_SID!, process.env.TWILIO_AUTH_TOKEN!);
        await tw.api.accounts.list({ limit: 1 });
        break;
    }
    
    return Response.json({ status: 'connected' });
  } catch (error) {
    return Response.json({ status: 'error', error: error.message }, { status: 500 });
  }
}
```

## Environment Variables

All integration secrets should be in environment variables:

```bash
# .env.local

# AI Models
OPENAI_API_KEY=sk-...

# Memory
SUPERMEMORY_API_KEY=sm_...

# Browser Automation
BROWSER_USE_API_KEY=bu_...

# Voice
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...

# App
APP_URL=https://your-app.vercel.app
APP_ENCRYPTION_KEY=...  # 32-byte hex
```

## Security Best Practices

1. **Never expose API keys client-side** - All integrations server-only
2. **Encrypt at rest** - Use AES-GCM for stored credentials
3. **Validate webhooks** - Always validate Twilio signatures
4. **Domain allowlists** - Restrict Browser-Use to allowed domains
5. **Rate limiting** - Implement rate limits for v2
6. **Error handling** - Never leak API keys in error messages
7. **Audit logs** - Log all integration usage

