## Twilio Voice Integration

### Setup

```bash
npm install twilio
```

Documentation: [docs/twilio/README.md](mdc:docs/twilio/README.md)

### Outbound Call Flow

1. **Create call request** → User approves activity in dashboard
2. **Initiate call** → POST /api/calls creates Twilio call
3. **TwiML webhook** → POST /api/twilio/voice returns TwiML
4. **WebSocket proxy** → Bridges Twilio Media Streams ↔ OpenAI Realtime
5. **Status callback** → POST /api/twilio/status handles call lifecycle
6. **Summarize call** → POST /api/calls/:id/summary generates summary

### Initiate Call

```typescript
// app/api/calls/route.ts
import twilio from 'twilio';

const client = twilio(
  process.env.TWILIO_ACCOUNT_SID!,
  process.env.TWILIO_AUTH_TOKEN!
);

export async function POST(request: Request) {
  const { agentId, toNumber, instructions } = await request.json();
  
  // Create call
  const call = await client.calls.create({
    to: toNumber,
    from: process.env.TWILIO_PHONE_NUMBER!,
    url: `${process.env.APP_URL}/api/twilio/voice`,
    statusCallback: `${process.env.APP_URL}/api/twilio/status`,
    statusCallbackEvent: ['initiated', 'ringing', 'answered', 'completed'],
    // Pass context via URL params
    url: `${process.env.APP_URL}/api/twilio/voice?agentId=${agentId}&callId=${call.sid}`,
  });
  
  // Save to database
  await sql`
    INSERT INTO calls (agent_id, to_number, status, twilio_sid)
    VALUES (${agentId}, ${toNumber}, 'initiated', ${call.sid})
  `;
  
  return Response.json({ call });
}
```

### TwiML Response

```typescript
// app/api/twilio/voice/route.ts
import { VoiceResponse } from 'twilio/lib/twiml/VoiceResponse';

export async function POST(request: Request) {
  const { searchParams } = new URL(request.url);
  const agentId = searchParams.get('agentId');
  const callId = searchParams.get('callId');
  
  const twiml = new VoiceResponse();
  
  // Connect to WebSocket for Realtime API
  const connect = twiml.connect();
  connect.stream({
    url: `wss://${process.env.APP_URL}/api/twilio/stream?agentId=${agentId}&callId=${callId}`,
  });
  
  return new Response(twiml.toString(), {
    headers: { 'Content-Type': 'text/xml' },
  });
}
```

