Reference: [docs/supermemory/memory-tools.md](mdc:docs/supermemory/memory-tools.md)

### Manual API Usage

```typescript
// app/api/memories/store/route.ts
import Supermemory from 'supermemory';

const client = new Supermemory({
  apiKey: process.env.SUPERMEMORY_API_KEY!,
});

export async function POST(request: Request) {
  const { agentId, content, metadata } = await request.json();
  
  // Store memory
  const memory = await client.documents.create({
    content,
    metadata: {
      agentId,
      ...metadata,
    },
  });
  
  // Save reference in database
  await sql`
    INSERT INTO memories (agent_id, provider_id, kind, metadata)
    VALUES (${agentId}, ${memory.id}, 'document', ${JSON.stringify(metadata)})
  `;
  
  return Response.json({ memory });
}
```

### Search Memories

```typescript
// app/api/memories/search/route.ts
export async function GET(request: Request) {
  const { searchParams } = new URL(request.url);
  const agentId = searchParams.get('agentId');
  const query = searchParams.get('q');
  
  const results = await client.search.documents({
    q: query,
    filters: {
      metadata: {
        agentId,
      },
    },
    limit: 10,
  });
  
  return Response.json({ results });
}
```

Reference: [docs/supermemory/ai-sdk-overview.md](mdc:docs/supermemory/ai-sdk-overview.md)

## Browser-Use Cloud Integration

### Setup

```bash
npm install browser-use-sdk
```

Documentation: [docs/browser-use/README.md](mdc:docs/browser-use/README.md)

### AI SDK Tool

```typescript
// lib/ai/tools/browser-task.ts
import { tool } from 'ai';
import { z } from 'zod';
import { BrowserUseClient } from 'browser-use-sdk';

const client = new BrowserUseClient({
  apiKey: process.env.BROWSER_USE_API_KEY!,
});

export const browserTaskTool = tool({
  description: 'Execute browser automation tasks like web scraping, form filling, or data extraction',
  
  inputSchema: z.object({
    task: z.string().describe('Natural language task description'),
    maxSteps: z.number().default(10).describe('Maximum automation steps'),
    schema: z.any().optional().describe('Zod schema for structured output'),
    allowedDomains: z.array(z.string()).optional().describe('Domain whitelist'),
  }),
  
  execute: async ({ task, maxSteps, schema, allowedDomains }) => {
    try {
      const browserTask = await client.tasks.createTask({
        task,
        maxSteps,
        schema,
        allowedDomains: allowedDomains ?? ['*'],
      });
      
      // Stream progress (optional)
      for await (const update of browserTask.stream()) {
        console.log('Browser task update:', update.status);
      }
      
      // Wait for completion
      const result = await browserTask.complete();
      
      return {
        success: true,
        output: result.output,
        parsed: result.parsed,
        steps: result.steps.length,
      };
    } catch (error) {
      return {
        success: false,
        error: error.message,
      };
    }
  },
});
```

Reference: [docs/browser-use/quickstart.md](mdc:docs/browser-use/quickstart.md)

### API Endpoint

```typescript
// app/api/browser/task/route.ts
export async function POST(request: Request) {
  const { task, maxSteps, schema } = await request.json();
  
  const browserTask = await client.tasks.createTask({
    task,
    maxSteps,
    schema,
  });
  
  return Response.json({
    taskId: browserTask.id,
    liveUrl: browserTask.liveUrl, // Watch in real-time
  });
}

// Get task status/result
export async function GET(request: Request) {
  const { searchParams } = new URL(request.url);
  const taskId = searchParams.get('taskId');
  
  const task = await client.tasks.getTask(taskId);
  
  return Response.json({
    status: task.status,
    output: task.output,
    parsed: task.parsed,
  });
}
```

### Advanced: Sessions and Profiles

```typescript
// Create persistent session
const session = await client.sessions.createSession({
  profileId: 'user_profile_123', // Persists cookies, login state
});

// Multi-step workflow
