# ===========================================
# Volition - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values:
#   cp env.example .env.local

# --- Required ---

# OpenAI (powers agent LLM reasoning)
OPENAI_API_KEY=sk-...

# NextAuth.js secret (generate with: openssl rand -base64 32)
# Required for production. Auto-generated in development.
AUTH_SECRET=

# --- Auto-Configured (optional) ---

# Neon Postgres (remote database)
# Omit to use PGlite (embedded Postgres) for local development — zero setup required.
# DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require
# DATABASE_URL_POOLED=postgresql://user:pass@host/dbname?sslmode=require&pgbouncer=true

# Encryption key for tool_configs table (generate with: openssl rand -hex 32)
# Omit in development — a deterministic dev key is used automatically.
# APP_ENCRYPTION_KEY=

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Optional Integrations ---

# Anthropic (alternative LLM provider — Claude models)
# ANTHROPIC_API_KEY=sk-ant-...

# Firecrawl (web search + scraping for research)
FIRECRAWL_API_KEY=fc_...

# Supermemory (semantic memory / knowledge graph)
SUPERMEMORY_API_KEY=sm_...

# Browser-Use Cloud (browser automation)
BROWSER_USE_API_KEY=bu_...

# Twilio (outbound voice calls)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1...

# Google APIs (Gmail + Calendar, OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Telegram Bot
TELEGRAM_BOT_TOKEN=
